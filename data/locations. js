/**
 * گرفتن اطلاعات یه لوکیشن
 */
function getLocation(locationId) {
  return locations[locationId] || locations.forest;
}

/**
 * لیست لوکیشن‌های در دسترس
 */
function getAvailableLocations() {
  return Object.values(locations).map(loc => ({
    id: loc.id,
    name: loc.name,
    danger: loc.danger,
  }));
}

module.exports = { locations, getLocation, getAvailableLocations };