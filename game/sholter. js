// سیستم پناهگاه - بقای فرمانروا
const { getPlayer, savePlayer, addExp } = require("./player");
const CONFIG = require("../utils/config");

/**
 * ارتقای پناهگاه
 */
function upgradeShelter(userId) {
  const player = getPlayer(userId);
  if (!player) return { ok: false, msg: "❌ بازیکن پیدا نشد!" };

  const currentLevel = player.shelterLevel;
  
  // چک ماکسیمم سطح
  if (currentLevel >= 5) {
    return { ok: false, msg: "❌ پناهگاهت در بالاترین سطحه!" };
  }

  const nextLevel = CONFIG.SHELTER[currentLevel + 1];
  if (!nextLevel) return { ok: false, msg: "❌ سطح بعدی وجود نداره!" };

  // چک منابع
  const missing = [];
  if (player.wood < (nextLevel.wood || 0)) missing.push(`چوب: ${player.wood}/${nextLevel.wood}`);
  if (player.stone < (nextLevel.stone || 0)) missing.push(`سنگ: ${player.stone}/${nextLevel.stone}`);
  if (player.iron < (nextLevel.iron || 0)) missing.push(`آهن: ${player.iron}/${nextLevel.iron}`);
  if (player.gold < (nextLevel.gold || 0)) missing.push(`سکه: ${player.gold}/${nextLevel.gold}`);

  if (missing.length > 0) {
    return { ok: false, msg: `❌ منابع کافی نداری!\n${missing.join("\n")}` };
  }

  // کم کردن منابع
  player.wood -= (nextLevel.wood || 0);
  player.stone -= (nextLevel.stone || 0);
  player.iron -= (nextLevel.iron || 0);
  player.gold -= (nextLevel.gold || 0);

  // ارتقا
  const oldShelter = CONFIG.SHELTER[currentLevel];
  player.shelterLevel++;

  // اثرات ارتقا
  const newShelter = CONFIG.SHELTER[player.shelterLevel];
  player.maxHealth += 10;
  player.health = Math.min(player.health + 15, player.maxHealth);

  addExp(userId, 30);
  savePlayer(userId, player);

  return {
    ok: true,
    oldLevel: currentLevel,
    oldName: oldShelter.name,
    newLevel: player.shelterLevel,
    newName: newShelter.name,
    newDefense: newShelter.defense,
    newHealRate: newShelter.healRate,
    newCapacity: newShelter.capacity,
  };
}

/**
 * گرفتن اطلاعات پناهگاه فعلی
 */
function getShelterInfo(userId) {
  const player = getPlayer(userId);
  if (!player) return null;

  const current = CONFIG.SHELTER[player.shelterLevel];
  const next = player.shelterLevel < 5 ? CONFIG.SHELTER[player.shelterLevel + 1] : null;

  return {
    level: player.shelterLevel,
    name: current.name,
    emoji: current.emoji,
    defense: current.defense,
    healRate: current.healRate,
    capacity: current.capacity,
    next: next ? {
      name: next.name,
      emoji: next.emoji,
      cost: {
        wood: next.wood || 0,
        stone: next.stone || 0,
        iron: next.iron || 0,
        gold: next.gold || 0,
      },
      defense: next.defense,
      healRate: next.healRate,
      capacity: next.capacity,
    } : null,
  };
}

module.exports = {
  upgradeShelter,
  getShelterInfo,
};