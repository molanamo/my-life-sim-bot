// نمایش وضعیت و کپشن‌های بازی بقای فرمانروا
const { getGlassBorder, formatNumber, progressBar, percent } = require("../utils/helpers");
const CONFIG = require("../utils/config");
const { kings } = require("../data/kings");
const { queens } = require("../data/queens");
const { weapons } = require("../data/weapons");
const { foods } = require("../data/foods");
const { getShelterInfo } = require("../game/shelter");
const { getBossByDay } = require("../data/enemies");

/**
 * متن کامل وضعیت بازیکن
 */
function getStatusText(player) {
  const shelter = getShelterInfo(player.userId);
  const nextBoss = getBossByDay(player.day);
  const weaponName = player.weapon ? weapons[player.weapon]?.name || "ندارد" : "ندارد";
  const armorName = player.armor ? weapons[player.armor]?.name || "ندارد" : "ندارد";

  return `${getGlassBorder()}
👑 **${player.kingName}** | روز ${player.day}/${CONFIG.MAX_DAYS}
${getGlassBorder()}

❤️ سلامت: ${progressBar(player.health, player.maxHealth)} ${percent(player.health, player.maxHealth)}
💰 سکه: ${formatNumber(player.gold)}
🍖 غذا: ${formatNumber(player.food)}
⚔️ سرباز: ${formatNumber(player.soldiers)}
🪵 چوب: ${formatNumber(player.wood)} | 🪨 سنگ: ${formatNumber(player.stone)} | ⛓️ آهن: ${formatNumber(player.iron)}

🏠 پناهگاه: ${shelter?.emoji || "🏕️"} ${shelter?.name || "کمپ"} (دفاع: ${shelter?.defense || 0}٪)
🗡️ سلاح: ${weaponName} | 🛡️ زره: ${armorName}
👸 ملکه: ${player.queens.length} نفر
⭐ سطح: ${player.level} | 📈 XP: ${player.exp}
⚡ اقدامات: ${player.actionsLeft}/${CONFIG.ACTIONS_PER_DAY}
${nextBoss ? `\n👹 باس بعدی: ${nextBoss.emoji} ${nextBoss.name} (روز ${nextBoss.day})` : ""}`;
}

/**
 * متن جمع‌آوری
 */
function gatherResultText(result) {
  if (!result.ok) return result.msg;
  
  const lines = [`🌲 **${result.location.name}**\n`];
  
  const resources = [];
  if (result.result.gold) resources.push(`💰 +${result.result.gold} سکه`);
  if (result.result.wood) resources.push(`🪵 +${result.result.wood} چوب`);
  if (result.result.stone) resources.push(`🪨 +${result.result.stone} سنگ`);
  if (result.result.iron) resources.push(`⛓️ +${result.result.iron} آهن`);
  if (result.result.food) resources.push(`🍖 +${result.result.food} غذا`);
  
  if (resources.length > 0) {
    lines.push("📦 **برداشت:**");
    lines.push(resources.join("\n"));
  } else {
    lines.push("📦 چیز خاصی پیدا نکردی...");
  }
  
  if (result.result.enemy) {
    lines.push(`\n⚠️ **${result.result.enemy.name}** بهت حمله کرد!`);
  }
  
  if (result.result.special) {
    lines.push(`\n✨ **${result.result.special.name}**\n${result.result.special.desc}`);
  }
  
  return lines.join("\n");
}

/**
 * متن نتیجه نبرد
 */
function battleResultText(result) {
  if (!result.ok) return result.msg;
  
  const lines = [];
  
  if (result.win) {
    lines.push("🎉 **پیروزی!**");
    lines.push(`⚔️ دشمن: ${result.enemy}`);
    if (result.rewards.gold) lines.push(`💰 +${result.rewards.gold} سکه`);
    if (result.rewards.exp) lines.push(`⭐ +${result.rewards.exp} تجربه`);
    if (result.rewards.item) lines.push(`🎁 آیتم: ${result.rewards.item}`);
  } else {
    lines.push("💀 **شکست...**");
    lines.push(`⚔️ دشمن: ${result.enemy}`);
    if (result.losses.health) lines.push(`❤️ -${result.losses.health} سلامت`);
    if (result.losses.soldiers) lines.push(`⚔️ -${result.losses.soldiers} سرباز`);
  }
  
  return lines.join("\n");
}

/**
 * متن نتیجه باس
 */
function bossResultText(result) {
  if (!result.ok) return result.msg;
  
  const lines = [];
  
  lines.push(`👹 **${result.boss}**`);
  lines.push(`❤️ تو: ${"❤️".repeat(result.playerHP)}${"🖤".repeat(3 - result.playerHP)}`);
  lines.push(`💚 باس: ${"💚".repeat(result.bossHP)}${"🖤".repeat(5 - result.bossHP)}`);
  
  if (result.win) {
    lines.push("\n🎉 **پیروزی بزرگ!**");
    if (result.rewards.gold) lines.push(`💰 +${result.rewards.gold} سکه`);
    if (result.rewards.exp) lines.push(`⭐ +${result.rewards.exp} تجربه`);
    if (result.rewards.item) lines.push(`🎁 آیتم: ${result.rewards.item}`);
    if (result.gameOver) lines.push("\n🏆 **آخرین باس رو شکست دادی! برنده شدی!**");
  } else {
    lines.push("\n💀 **شکست خوردی...**");
    if (result.losses.health) lines.push(`❤️ -${result.losses.health} سلامت`);
    if (result.losses.soldiers) lines.push(`⚔️ -${result.losses.soldiers} سرباز`);
    if (result.specialUsed) lines.push(`\n⚡ حمله ویژه: ${result.specialUsed}`);
  }
  
  return lines.join("\n");
}

/**
 * متن رویداد شبانه
 */
function eventText(event, player) {
  const lines = [
    `🌙 **رویداد شب: ${event.name}**`,
    `\n${event.desc}`,
    "\n📊 اثرات:",
  ];
  
  for (const [key, val] of Object.entries(event.effect)) {
    const names = { gold: "💰 سکه", food: "🍖 غذا", wood: "🪵 چوب", stone: "🪨 سنگ", iron: "⛓️ آهن", soldiers: "⚔️ سرباز", health: "❤️ سلامت" };
    const name = names[key] || key;
    const sign = val > 0 ? "+" : "";
    lines.push(`${name}: ${sign}${val}`);
  }
  
  return lines.join("\n");
}

/**
 * متن PvP
 */
function pvpResultText(result) {
  if (!result.ok) return result.msg;
  
  const lines = [];
  const icon = result.isRevenge ? "🔥" : "⚔️";
  
  lines.push(`${icon} **${result.isRevenge ? "انتقام" : "حمله"} به ${result.targetName}**`);
  lines.push(`👑 ${result.targetKing}`);
  
  if (result.win) {
    lines.push("\n🎉 **پیروز شدی!**");
    if (result.stolen) {
      lines.push("💰 غنیمت:");
      if (result.stolen.gold) lines.push(`   💰 ${result.stolen.gold} سکه`);
      if (result.stolen.food) lines.push(`   🍖 ${result.stolen.food} غذا`);
      if (result.stolen.iron) lines.push(`   ⛓️ ${result.stolen.iron} آهن`);
      if (result.stolen.wood) lines.push(`   🪵 ${result.stolen.wood} چوب`);
      if (result.stolen.stone) lines.push(`   🪨 ${result.stolen.stone} سنگ`);
    }
  } else {
    lines.push("\n💀 **شکست خوردی...**");
    if (result.losses.health) lines.push(`❤️ -${result.losses.health} سلامت`);
    if (result.losses.soldiers) lines.push(`⚔️ -${result.losses.soldiers} سرباز`);
  }
  
  return lines.join("\n");
}

/**
 * متن عیاشی
 */
function partyResultText(result) {
  if (!result.ok) return result.msg;
  
  const lines = ["🎉 **عیاشی!**", "", result.event];
  
  if (result.effects) {
    lines.push("\n📊 اثرات:");
    if (result.effects.health) lines.push(`   ❤️ سلامت: ${result.effects.health > 0 ? "+" : ""}${result.effects.health}`);
    if (result.effects.food) lines.push(`   🍖 غذا: ${result.effects.food > 0 ? "+" : ""}${result.effects.food}`);
    if (result.effects.gold) lines.push(`   💰 سکه: ${result.effects.gold > 0 ? "+" : ""}${result.effects.gold}`);
    if (result.effects.soldiers) lines.push(`   ⚔️ سرباز: ${result.effects.soldiers > 0 ? "+" : ""}${result.effects.soldiers}`);
  }
  
  return lines.join("\n");
}

module.exports = {
  getStatusText,
  gatherResultText,
  battleResultText,
  bossResultText,
  eventText,
  pvpResultText,
  partyResultText,
};