// پنل ادمین مخفی - بقای فرمانروا
const { getPlayer, savePlayer, deletePlayer } = require("../game/player");
const { adminPanel } = require("./menus");

// دیتابیس موقت برای عملیات ادمین
const adminActions = new Map();

/**
 * نمایش پنل ادمین
 */
async function showAdminPanel(ctx) {
  await ctx.reply(
    `👑 **پنل ادمین مخفی**\n\n🎮 بقای فرمانروا\n👤 ${ctx.from.first_name}\n\nیه گزینه رو انتخاب کن:`,
    { parse_mode: "Markdown", reply_markup: adminPanel() }
  );
}

/**
 * هندلر دکمه‌های ادمین
 */
async function handleAdminCallback(ctx) {
  const data = ctx.callbackQuery.data;
  const adminId = ctx.from.id;

  // عملیات‌های نیازمند ورودی
  const actions = {
    admin_give_gold: "give_gold",
    admin_give_food: "give_food",
    admin_give_soldiers: "give_soldiers",
    admin_give_wood: "give_wood",
    admin_give_stone: "give_stone",
    admin_give_iron: "give_iron",
    admin_full: "full_upgrade",
    admin_kill: "kill_player",
    admin_reset: "reset_player",
  };

  if (actions[data]) {
    adminActions.set(adminId, actions[data]);
    const names = {
      give_gold: "💰 هدیه سکه", give_food: "🍖 هدیه غذا", give_soldiers: "⚔️ هدیه سرباز",
      give_wood: "🪵 هدیه چوب", give_stone: "🪨 هدیه سنگ", give_iron: "⛓️ هدیه آهن",
      full_upgrade: "🏆 فول کردن", kill_player: "💀 کشتن", reset_player: "🔄 ریست",
    };
    const examples = {
      give_gold: "5576592239 5000",
      give_food: "5576592239 100",
      give_soldiers: "5576592239 50",
      give_wood: "5576592239 200",
      give_stone: "5576592239 150",
      give_iron: "5576592239 100",
      full_upgrade: "5576592239",
      kill_player: "5576592239",
      reset_player: "5576592239",
    };
    await ctx.reply(`${names[actions[data]]}\n\nفرمت: \`${examples[actions[data]]}\`\n/cancel برای لغو`, { parse_mode: "Markdown" });
    return;
  }

  // لیست بازیکن‌ها
  if (data === "admin_list") {
    const { getPlayer } = require("../game/player");
    const allPlayers = [];
    // چون Map داریم، باید همه رو بگیریم
    const { players } = require("../game/player");
    if (players) {
      for (const [id, p] of players) {
        allPlayers.push(`${p.firstName || "ناشناس"} | ID: \`${id}\` | روز ${p.day} | ${p.alive ? "🟢" : "💀"}`);
      }
    }
    const text = allPlayers.length > 0 ? allPlayers.join("\n") : "هیچ بازیکنی نیست";
    await ctx.reply(`📊 **لیست بازیکن‌ها** (${allPlayers.length} نفر)\n\n${text}`, { parse_mode: "Markdown" });
    return;
  }

  // آمار
  if (data === "admin_stats") {
    const { players } = require("../game/player");
    let total = 0, alive = 0, dead = 0;
    if (players) {
      for (const [, p] of players) {
        total++;
        if (p.alive) alive++; else dead++;
      }
    }
    await ctx.reply(`📈 **آمار سرور**\n\n👥 کل بازیکن‌ها: ${total}\n🟢 زنده: ${alive}\n💀 مرده: ${dead}\n📦 حجم دیتابیس: ${total} رکورد`);
    return;
  }

  // بستن پنل
  if (data === "admin_close") {
    await ctx.deleteMessage().catch(() => {});
    return;
  }
}

/**
 * پردازش پیام‌های ادمین
 */
async function handleAdminMessage(ctx) {
  const adminId = ctx.from.id;
  const action = adminActions.get(adminId);
  if (!action) return false;

  const text = ctx.message.text;
  if (text === "/cancel") {
    adminActions.delete(adminId);
    await ctx.reply("❌ عملیات لغو شد.");
    return true;
  }

  const parts = text.split(" ");
  const targetId = parseInt(parts[0]);
  const amount = parseInt(parts[1]);
  const player = getPlayer(targetId);

  if (!player) {
    await ctx.reply("❌ بازیکن با این ID پیدا نشد!");
    adminActions.delete(adminId);
    return true;
  }

  switch (action) {
    case "give_gold":
      player.gold += amount || 0;
      await ctx.reply(`✅ ${amount}💰 سکه به ${player.firstName} داده شد.`);
      break;
    case "give_food":
      player.food += amount || 0;
      await ctx.reply(`✅ ${amount}🍖 غذا به ${player.firstName} داده شد.`);
      break;
    case "give_soldiers":
      player.soldiers += amount || 0;
      await ctx.reply(`✅ ${amount}⚔️ سرباز به ${player.firstName} داده شد.`);
      break;
    case "give_wood":
      player.wood += amount || 0;
      await ctx.reply(`✅ ${amount}🪵 چوب به ${player.firstName} داده شد.`);
      break;
    case "give_stone":
      player.stone += amount || 0;
      await ctx.reply(`✅ ${amount}🪨 سنگ به ${player.firstName} داده شد.`);
      break;
    case "give_iron":
      player.iron += amount || 0;
      await ctx.reply(`✅ ${amount}⛓️ آهن به ${player.firstName} داده شد.`);
      break;
    case "full_upgrade":
      player.gold = 99999;
      player.food = 999;
      player.wood = 999;
      player.stone = 999;
      player.iron = 999;
      player.soldiers = 999;
      player.health = player.maxHealth;
      player.shelterLevel = 5;
      player.weapon = "axe_upgraded";
      player.armor = "dragon_armor";
      await ctx.reply(`✅ ${player.firstName} فول شد! 🏆`);
      break;
    case "kill_player":
      player.alive = false;
      player.health = 0;
      await ctx.reply(`💀 ${player.firstName} کشته شد.`);
      break;
    case "reset_player":
      deletePlayer(targetId);
      await ctx.reply(`🔄 ${player.firstName} ریست شد.`);
      break;
  }

  savePlayer(targetId, player);
  adminActions.delete(adminId);
  return true;
}

module.exports = { showAdminPanel, handleAdminCallback, handleAdminMessage };