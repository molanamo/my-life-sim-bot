// سیستم حرمسرا - بقای فرمانروا
const { getPlayer, savePlayer, addExp } = require("./player");
const { queens, kingQueens } = require("../data/queens");
const { kings } = require("../data/kings");

/**
 * ازدواج با یه ملکه
 */
function marryQueen(userId, queenId) {
  const player = getPlayer(userId);
  if (!player) return { ok: false, msg: "❌ بازیکن پیدا نشد!" };

  const queen = queens[queenId];
  if (!queen) return { ok: false, msg: "❌ این ملکه وجود نداره!" };

  // چک اینکه قبلاً این ملکه رو داری
  if (player.queens.includes(queenId)) {
    return { ok: false, msg: `❌ ${queen.name} قبلاً توی حرمسراته!` };
  }

  // چک پول
  if (player.gold < queen.cost) {
    return { ok: false, msg: `❌ سکه کافی نداری! نیاز: ${queen.cost}` };
  }

  // پرداخت
  player.gold -= queen.cost;
  player.queens.push(queenId);

  addExp(userId, 20);
  savePlayer(userId, player);

  return {
    ok: true,
    queen: queen.name,
    bonus: queen.bonusDesc,
    cost: queen.cost,
  };
}

/**
 * طلاق دادن ملکه
 */
function divorceQueen(userId, queenId) {
  const player = getPlayer(userId);
  if (!player) return { ok: false, msg: "❌ بازیکن پیدا نشد!" };

  const queen = queens[queenId];
  if (!queen) return { ok: false, msg: "❌ این ملکه وجود نداره!" };

  // چک اینکه تو حرمسرا هست
  if (!player.queens.includes(queenId)) {
    return { ok: false, msg: `❌ ${queen.name} توی حرمسرات نیست!` };
  }

  // طلاق (نصف پول برمیگرده)
  const refund = Math.floor(queen.cost / 2);
  player.queens = player.queens.filter(q => q !== queenId);
  player.gold += refund;

  savePlayer(userId, player);

  return {
    ok: true,
    queen: queen.name,
    refund,
  };
}

/**
 * گرفتن لیست ملکه‌های بازیکن
 */
function getPlayerQueens(userId) {
  const player = getPlayer(userId);
  if (!player) return [];

  return player.queens.map(qId => {
    const q = queens[qId];
    return q ? { id: qId, name: q.name, bonus: q.bonusDesc, photo: q.photo } : null;
  }).filter(Boolean);
}

/**
 * گرفتن ملکه‌های قابل ازدواج
 */
function getAvailableQueens(userId) {
  const player = getPlayer(userId);
  if (!player) return [];

  return Object.values(queens).filter(q => !player.queens.includes(q.id));
}

/**
 * ملکه‌های پیشنهادی بر اساس پادشاه
 */
function getSuggestedQueens(kingId) {
  const suggested = kingQueens[kingId] || [];
  return suggested.map(qId => {
    const q = queens[qId];
    return q ? { id: qId, name: q.name, bonus: q.bonusDesc, cost: q.cost, photo: q.photo } : null;
  }).filter(Boolean);
}

module.exports = {
  marryQueen,
  divorceQueen,
  getPlayerQueens,
  getAvailableQueens,
  getSuggestedQueens,
};